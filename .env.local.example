# This site's own public deployment URL (no trailing slash), e.g.
# https://cleano.services. Used to build absolute links (OG tags, quote
# confirmation emails) that shouldn't be derived from request headers.
NEXT_PUBLIC_APP_URL=

# The Cleano Ops app, where the "Get a Quote" flow ultimately hands off leads
# and where the customer booking portal lives.
NEXT_PUBLIC_OPS_APP_URL=https://ops.cleano.services

# Supabase (Project Settings -> API) - a SEPARATE Supabase project from
# Cleano Ops, so a leaked marketing-site key can't touch operational data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (resend.com/api-keys) - sends the internal "new lead" notification
# email and the customer's "we got your quote request" confirmation.
RESEND_API_KEY=
LEADS_NOTIFICATION_EMAIL=info@cleano.services

# Public contact details shown across the site (footer, sticky bar, WhatsApp
# button). Kept as env vars so they can change without a code edit.
NEXT_PUBLIC_CONTACT_PHONE=02033704040
NEXT_PUBLIC_CONTACT_PHONE_DISPLAY="020 3370 4040"
NEXT_PUBLIC_CONTACT_EMAIL=info@cleano.services
# WhatsApp deep links need the number in international format, no leading 0/+.
NEXT_PUBLIC_WHATSAPP_NUMBER=442033704040

# Optional bot protection for the quote form (Cloudflare dashboard ->
# Turnstile - same account already used for this domain's DNS). The form
# and API both work fine with these unset; adding them just makes the
# quote form require a passed Turnstile check before it's accepted.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
